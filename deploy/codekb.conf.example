# ============================================================================
# CodeKB deployment config  (sourced by deploy/install.sh)
# Edit values here; every one can also be overridden with a --flag at runtime.
# Blank values are auto-derived (account via STS, buckets from the account).
# ============================================================================

# --- AWS identity ---
AWS_PROFILE=""                      # blank = default credential chain
AWS_ACCOUNT_ID=""                   # blank = auto-detect via `aws sts get-caller-identity`

# --- Regions (one default feeds all three; override individually if needed) ---
AWS_REGION="us-east-1"
CODEKB_S3_REGION=""
CODEKB_S3_VECTORS_REGION=""
CODEKB_BEDROCK_REGION=""

# --- Storage (blank = codekb-knowledgebase-<acct> / codekb-vectors-<acct>) ---
CODEKB_S3_BUCKET=""
CODEKB_S3_VECTORS_BUCKET=""
CODEKB_S3_VECTORS_INDEX="codekb-index"

# --- Bedrock ---
CODEKB_BEDROCK_MODEL_ID="us.anthropic.claude-opus-4-6-v1"
CODEKB_BEDROCK_MAX_TOKENS="65000"
CODEKB_SUMMARIZATION_CONCURRENCY="40"
CODEKB_BEDROCK_GUARDRAIL_ENABLED="false"  # true needs the guardrail made by infra/cli/setup_aws.sh

# --- App behaviour ---
CODEKB_LOG_LEVEL="WARNING"
CODEKB_REQUIRE_AUTHENTICATION="false"    # localhost-only deploy; leave false
CODEKB_REQUIRE_AUTHORIZATION="false"     # single user: every space is visible (old behaviour)
CODEKB_SECURITY_HEADERS_ENABLED="false"  # false = dashboard can embed the UI in its iframe

# --- Git host allowlist (space- or comma-separated hostnames, NOT URLs) ---
# Subdomains match automatically. REQUIRED for git-by-URL; empty = zip upload only.
CODEKB_ALLOWED_GIT_HOSTS="github.com"

# --- Networking ---
HOST_BIND="127.0.0.1"               # loopback only (CodeKB has no auth here)
HOST_PORT="8742"
CONTAINER_NAME="codekb"

# --- Runtime ---
CREDS_MODE="profile"                # profile | env | role
CONTAINER_ENGINE="docker"           # docker | finch
RESTART_POLICY="unless-stopped"     # always-restart service; survives reboot

# --- Git access over ssh ---
GIT_SSH_DIR="$HOME/.ssh"            # mounted read-only so CodeKB can clone over ssh; "" = off
GIT_SSH_KEY="id_ecdsa"              # key in GIT_SSH_DIR used for git clones
